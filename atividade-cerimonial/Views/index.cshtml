<div class="container">

        <div>

            <p class="eyebrow mb-1">
                ÁREA ADMINISTRATIVA
            </p>

            <h1 class="section-title mb-0">
                Cerimônias
            </h1>

        </div>

        <a asp-action="Criar"
           class="btn btn-wine">
            + Nova cerimônia
        </a>

    </div>


    @if (TempData["Mensagem"] is not null)
    {
        <div class="alert alert-success">
            @TempData["Mensagem"]
        </div>
    }


    @if (!Model.Any())
    {
        <div class="text-center bg-soft rounded-4 p-5">

            <h2 class="h4">
                Nenhuma cerimônia cadastrada
            </h2>

            <p>
                Comece cadastrando o primeiro casal.
            </p>

            <a asp-action="Criar"
               class="btn btn-outline-wine">
                Cadastrar agora
            </a>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var c in Model)
            {
                <div class="col-md-6 col-xl-4">

                    <article class="card h-100 border-0 shadow-sm ceremony-card">

                        <div class="card-body p-4">

                            <p class="eyebrow mb-2">
                                @c.Data.ToString("dd/MM/yyyy")
                            </p>

                            <h2 class="h4">
                                @c.Noiva &amp; @c.Noivo
                            </h2>

                            <hr />

                            <p>
                                <strong>Local:</strong>
                                @c.Local
                            </p>

                            <p>
                                <strong>Convidados:</strong>
                                @c.QuantidadeConvidados
                            </p>

                            <form asp-action="Excluir"
                                  method="post">

                                <input type="hidden"
                                       name="id"
                                       value="@c.Id" />

                                <button class="btn btn-sm btn-outline-danger"
                                        type="submit">
                                    Excluir
                                </button>

                            </form>

                        </div>

                    </article>

                </div>
            }

        </div>
    }

</div>